# 面板公开端口。必须同时在 Oracle 云防火墙和系统防火墙允许必要来源。
HUB_PORT=8765
HUB_BIND_ADDRESS=0.0.0.0
# 替换 YOUR_SERVER_IP。允许 IP+端口和 HTTP。
HUB_PUBLIC_URL=http://YOUR_SERVER_IP:8765
# 留空沿用 HUB_PUBLIC_URL。公开 HTTPS 直连 ChatGPT 时填 https://你的域名。
MCP_PUBLIC_URL=
TZ=Asia/Taipei
# 只信任你实际控制的反向代理来源，不要在公网直连情况下填 *。
FORWARDED_ALLOW_IPS=127.0.0.1
OAUTH_REDIRECT_HOSTS=chatgpt.com,chat.openai.com,platform.openai.com,localhost,127.0.0.1,::1
# 可选 Caddy HTTPS 覆盖文件所需
MCP_DOMAIN=mcp.example.com
TLS_EMAIL=admin@example.com

# v1.1：首次执行前的排队有效期。已经启动的任务不因此中断。
HUB_QUEUE_TTL_SECONDS=1800
# 在线普通调用最多同步等待 8 秒，再返回 operation_id；范围 0–10。
HUB_CALL_WAIT_SECONDS=8
# 已提交操作的交付/状态探测基础间隔；范围 0.2–30 秒。
HUB_DELIVERY_RETRY_SECONDS=5

# 可选：仅禁止非管理员 MCP 启动/使用本机 Codex；普通 Shell、Pi 和面板原生会话不受影响。
MCP_BLOCK_LOCAL_CODEX=false

# CodePier uses explicit external volumes. install.sh migrates recognized legacy data.
CODEPIER_HUB_DATA_VOLUME=codepier-hub-data
CODEPIER_CADDY_DATA_VOLUME=codepier-caddy-data
CODEPIER_CADDY_CONFIG_VOLUME=codepier-caddy-config


# Optional host-managed panel updates. Keep empty until the updater sets these.
CODEPIER_HUB_IMAGE=
CODEPIER_HUB_SOURCE=
