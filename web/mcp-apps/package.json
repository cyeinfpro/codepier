{
  "name": "codepier-mcp-apps",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build-core.mjs && node build-room.mjs && node build.mjs",
    "format": "prettier --write ../*.js ../*.css ../core/*.mjs *.mjs ../collaboration-room/*.mjs ../chat/*.js ../chat/styles/*.css ../collaboration-room/styles/*.css",
    "format:check": "prettier --check ../*.js ../*.css ../core/*.mjs *.mjs ../collaboration-room/*.mjs ../chat/*.js ../chat/styles/*.css ../collaboration-room/styles/*.css"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.4"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "prettier": "3.9.10"
  },
  "overrides": {
    "@modelcontextprotocol/client": "2.3.0",
    "@modelcontextprotocol/core": "2.3.0",
    "zod": "4.6.6"
  }
}
