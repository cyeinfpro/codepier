{
  "name": "codepier-mcp-apps",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build-core.mjs && node build-room.mjs && node build-terminal.mjs && node build.mjs",
    "format": "prettier --write '../*.js' '!../collaboration-room.js' '!../vps-terminal.js' '../*.css' '!../vps-terminal.css' ../core/*.mjs *.mjs ../collaboration-room/*.mjs ../chat/*.js ../chat/styles/*.css ../collaboration-room/styles/*.css ../vps-terminal/*.mjs ../vps-terminal/styles.css",
    "format:check": "prettier --check '../*.js' '!../collaboration-room.js' '!../vps-terminal.js' '../*.css' '!../vps-terminal.css' ../core/*.mjs *.mjs ../collaboration-room/*.mjs ../chat/*.js ../chat/styles/*.css ../collaboration-room/styles/*.css ../vps-terminal/*.mjs ../vps-terminal/styles.css"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "esbuild": "0.28.2",
    "prettier": "3.10.1"
  },
  "overrides": {
    "@modelcontextprotocol/client": "2.3.0",
    "@modelcontextprotocol/core": "2.3.0",
    "zod": "4.6.6"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.1.0-beta.339"
  }
}
